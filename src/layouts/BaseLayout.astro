---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import { LANGUAGES } from '../languages';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  canonical?: string;
  lang?: string;
  locale?: string;
  /** 当前页面的语言代码（用于生成 hreflang，不传则不输出 hreflang） */
  currentLang?: string;
  /** 当前页面的相对路径（不含语言前缀，如 product/xxx/），用于拼接各语言 URL */
  relPath?: string;
  /** schema.org @type for the WebPage node (WebPage / ItemPage / CollectionPage / Blog / AboutPage…) */
  pageType?: string;
  /** Breadcrumb trail below Home, e.g. [{ name: 'Product', href: '/product/' }] */
  breadcrumbs?: { name: string; href: string }[];
  /** Label for the final breadcrumb when it differs from the title */
  crumbName?: string;
  /** Emit <meta name="robots" content="noindex, nofollow"> (404 page etc.) */
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/default-og.png',
  type = 'website',
  canonical,
  lang = 'en',
  locale = 'en_US',
  currentLang,
  relPath,
  pageType = 'WebPage',
  breadcrumbs = [],
  crumbName,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.potatoesflakes.com');
const siteUrl = site.toString().replace(/\/$/, '');
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.href;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const pageId = canonicalUrl.replace(/\/+$/, '') + '/#webpage';

// BreadcrumbList: Home → intermediate trails → current page
const crumbList: any[] = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
  ...breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 2,
    name: b.name,
    item: b.href.startsWith('http') ? b.href : `${siteUrl}${b.href}`,
  })),
];
if (crumbList[crumbList.length - 1].item !== canonicalUrl) {
  crumbList.push({
    '@type': 'ListItem',
    position: crumbList.length + 1,
    name: crumbName ?? title,
    item: canonicalUrl,
  });
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} - XION Potato Flakes Manufacturer</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="XION Potato Flakes Manufacturer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale} />

    {/* hreflang：多语言页面标注全部语言版本 */}
    {currentLang && relPath && (
      <>
        {LANGUAGES.map((l) => (
          <link rel="alternate" hreflang={l.code === 'yua' ? 'zh-yue' : l.code} href={`${siteUrl}/${l.code}/${relPath}`} />
        ))}
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}/${relPath}`} />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Organization / WebSite / WebPage / BreadcrumbList JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': `${siteUrl}/#organization`,
          name: 'XION Potato Flakes Manufacturer',
          alternateName: 'DinWeys Biotech Co., Ltd',
          url: siteUrl,
          logo: {
            '@type': 'ImageObject',
            url: `${siteUrl}/wp-content/uploads/2026/06/logo.png`,
          },
          contactPoint: [
            {
              '@type': 'ContactPoint',
              telephone: '+86 400-633-0616',
              contactType: 'sales',
              email: 'Ashelyhongjigroupllc@gmail.com',
              availableLanguage: ['en', 'zh'],
              areaServed: 'Worldwide',
            },
          ],
          address: {
            '@type': 'PostalAddress',
            streetAddress: '3# building, high tech new town, North Silicon Valley Qiaodong District',
            addressLocality: 'Zhangjiakou City',
            addressRegion: 'Hebei',
            addressCountry: 'CN',
          },
          hasCredential: [
            { '@type': 'Certification', name: 'FSSC 22000 food safety system certification' },
            { '@type': 'Certification', name: 'ISO 9001 quality management system' },
            { '@type': 'Certification', name: 'ISO 22000 food safety management system' },
            { '@type': 'Certification', name: 'HACCP food safety certification' },
            { '@type': 'Certification', name: 'BRC food safety certification' },
            { '@type': 'Certification', name: 'Halal certification' },
          ],
        },
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}/#website`,
          url: siteUrl,
          name: 'XION Potato Flakes Manufacturer',
          publisher: { '@id': `${siteUrl}/#organization` },
        },
        {
          // EEAT：站点技术内容的署名实体（团队署名）
          '@type': 'Organization',
          '@id': `${siteUrl}/about-us/#team`,
          name: 'XION Tech Team',
          description:
            'The production, quality-assurance and export team at XION / DinWeys Biotech that researches, writes and reviews the technical content on this site.',
          url: `${siteUrl}/about-us/`,
          parentOrganization: { '@id': `${siteUrl}/#organization` },
          knowsAbout: [
            'Potato flakes manufacturing',
            'Instant mashed potato (dehydrated) production',
            'Frozen french fries',
            'Potato starch',
            'Food safety certification (FSSC 22000, ISO 22000, HACCP, BRC)',
            'OEM / private-label packing',
          ],
        },
        {
          '@type': pageType,
          '@id': pageId,
          url: canonicalUrl,
          name: title,
          description: description,
          inLanguage: lang,
          isPartOf: { '@id': `${siteUrl}/#website` },
          about: { '@id': `${siteUrl}/#organization` },
        },
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonicalUrl}#breadcrumbs`,
          itemListElement: crumbList,
        },
      ],
    })} />
  </head>
  <body class="min-h-screen bg-white">
    <slot />
  </body>
</html>
