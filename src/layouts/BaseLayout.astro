---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import { LANGUAGES } from '../languages';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  canonical?: string;
  lang?: string;
  locale?: string;
  /** 当前页面的语言代码（用于生成 hreflang，不传则不输出 hreflang） */
  currentLang?: string;
  /** 当前页面的相对路径（不含语言前缀，如 product/xxx/），用于拼接各语言 URL */
  relPath?: string;
  /** schema.org @type for the WebPage node (WebPage / ItemPage / CollectionPage / Blog / AboutPage…) */
  pageType?: string;
  /** Breadcrumb trail below Home, e.g. [{ name: 'Product', href: '/product/' }] */
  breadcrumbs?: { name: string; href: string }[];
  /** Label for the final breadcrumb when it differs from the title */
  crumbName?: string;
  /** Emit <meta name="robots" content="noindex, nofollow"> (404 page etc.) */
  noindex?: boolean;
  /** FAQ 问答对，渲染为 FAQPage 结构化数据 */
  faq?: { q: string; a: string }[];
  /** 强制不在 title 后追加品牌后缀（首页等已含品牌词的页面） */
  noBrand?: boolean;
  /** 该页是否在所有语言下都存在（默认 true；仅英文页如 cart/checkout 传 false） */
  translated?: boolean;
}

const {
  title,
  description,
  image = '/default-og.png',
  type = 'website',
  canonical,
  lang = 'en',
  locale = 'en_US',
  currentLang,
  relPath,
  pageType = 'WebPage',
  breadcrumbs = [],
  crumbName,
  noindex = false,
  faq,
  noBrand = false,
  translated = true,
} = Astro.props;

const site = Astro.site ?? new URL('https://potatoesflakes.com');
const siteUrl = site.toString().replace(/\/$/, '');
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.href;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const pageId = canonicalUrl.replace(/\/+$/, '') + '/#webpage';

// ── hreflang ─────────────────────────────────────────────────────────────
// 从当前 URL 自动推导「语言前缀」与「无语言相对路径」，再反推全部语言版本。
// 英文是语言集群的默认版本（无前缀），必须与其它语言互指，否则 Google 丢弃整簇。
const LANG_CODES = LANGUAGES.map((l) => l.code);
const __segs = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const __list = __segs ? __segs.split('/') : [];
const __first = __list[0] ?? '';
const __hasPrefix = LANG_CODES.includes(__first);
// 无语言前缀的路径（英文页为 ''，翻译页为去掉前缀后的部分）
const autoRelPath = (__hasPrefix ? __list.slice(1) : __list).join('/');
const autoRelAbs = autoRelPath ? `/${autoRelPath}/` : '/';
// 显式 prop 优先，否则用自动推导
const effectiveRelPath = relPath !== undefined ? (relPath ? `/${relPath.replace(/^\/+|\/+$/g, '')}/` : '/') : autoRelAbs;
const enableHreflang = !noindex && translated;

// ── title ────────────────────────────────────────────────────────────────
// 品牌后缀仅在总长 ≤ 60 字符时追加，避免 67% 页面标题被截断；
// 翻译内容标题本身过长（阿拉伯语最长 105 字符）时，在词边界截断。
const BRAND_SUFFIX = ' - XION';
const TITLE_LIMIT = 68;
function clampTitle(s: string): string {
  const t = (s ?? '').replace(/\s+/g, ' ').trim();
  if (t.length <= TITLE_LIMIT) return t;
  let cut = t.slice(0, TITLE_LIMIT);
  const sp = cut.lastIndexOf(' ');
  if (sp > TITLE_LIMIT * 0.55) cut = cut.slice(0, sp);
  return cut.replace(/[\s,;:.\-–—、，|/]+$/, '') + '…';
}
const baseTitle = clampTitle(title);
const finalTitle =
  noBrand || (baseTitle + BRAND_SUFFIX).length > 60 ? baseTitle : baseTitle + BRAND_SUFFIX;

// ── meta description ─────────────────────────────────────────────────────
// 超过 160 字符会被 SERP 截断；表述里的 " 会被 Astro 转成 &#34;（6 字符），
// 所以按「转义后长度」截断，否则边界页仍会溢出 160。
const DESC_LIMIT = 158;
const escLen = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').length;
function clampDesc(s: string): string {
  let t = (s ?? '').replace(/\s+/g, ' ').trim();
  if (escLen(t) <= DESC_LIMIT) return t;
  while (t.length > 0 && escLen(t + '…') > DESC_LIMIT) {
    let cut = t.slice(0, Math.max(0, t.length - 2));
    // 拉丁文本尽量在词边界切；CJK/阿拉伯文无空格时直接切
    const sp = cut.lastIndexOf(' ');
    if (sp > cut.length * 0.75) cut = cut.slice(0, sp);
    t = cut.replace(/[\s,;:.\-–—、，|/]+$/, '');
  }
  return t + '…';
}
const finalDesc = clampDesc(description);

// BreadcrumbList: Home → intermediate trails → current page
const crumbList: any[] = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
  ...breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 2,
    name: b.name,
    item: b.href.startsWith('http') ? b.href : `${siteUrl}${b.href}`,
  })),
];
if (crumbList[crumbList.length - 1].item !== canonicalUrl) {
  crumbList.push({
    '@type': 'ListItem',
    position: crumbList.length + 1,
    name: crumbName ?? title,
    item: canonicalUrl,
  });
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDesc} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="XION Potato Flakes Manufacturer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={finalDesc} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale} />

    {/* hreflang：全语言互指 + 自反 + x-default，英文（无前缀）也必须在列 */}
    {enableHreflang && (
      <>
        <link rel="alternate" hreflang="en" href={`${siteUrl}${effectiveRelPath}`} />
        {LANGUAGES.map((l) => (
          <link
            rel="alternate"
            hreflang={l.code === 'yua' ? 'zh-yue' : l.code}
            href={`${siteUrl}/${l.code}${effectiveRelPath}`}
          />
        ))}
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}${effectiveRelPath}`} />
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={finalDesc} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Organization / WebSite / WebPage / BreadcrumbList JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': `${siteUrl}/#organization`,
          name: 'XION Potato Flakes Manufacturer',
          alternateName: ['DinWeys Biotech Co., Ltd', 'Xion Biotech Co., Ltd.', 'Dinweys'],
          url: siteUrl,
          // 站外已验证的实体锚点，帮助搜索引擎归并同名实体
          sameAs: [
            'https://www.potatopro.com/companies/xion-biotech',
            'https://www.brandsoftheworld.com/logo/xion-potato-flakes-manufacturer',
            'https://seeklogo.com/vector-logo/529973/xion-potato-flakes-manufacturer',
          ],
          logo: {
            '@type': 'ImageObject',
            url: `${siteUrl}/wp-content/uploads/2026/06/logo.png`,
          },
          contactPoint: [
            {
              '@type': 'ContactPoint',
              telephone: '+86 400-633-0616',
              contactType: 'sales',
              email: 'Ashelyhongjigroupllc@gmail.com',
              availableLanguage: ['en', 'zh'],
              areaServed: 'Worldwide',
            },
          ],
          address: {
            '@type': 'PostalAddress',
            streetAddress: '3# building, high tech new town, North Silicon Valley Qiaodong District',
            addressLocality: 'Zhangjiakou City',
            addressRegion: 'Hebei',
            addressCountry: 'CN',
          },
          hasCredential: [
            { '@type': 'Certification', name: 'FSSC 22000 food safety system certification' },
            { '@type': 'Certification', name: 'ISO 9001 quality management system' },
            { '@type': 'Certification', name: 'ISO 22000 food safety management system' },
            { '@type': 'Certification', name: 'HACCP food safety certification' },
            { '@type': 'Certification', name: 'BRC food safety certification' },
            { '@type': 'Certification', name: 'Halal certification' },
          ],
        },
        {
          '@type': 'WebSite',
          '@id': `${siteUrl}/#website`,
          url: siteUrl,
          name: 'XION Potato Flakes Manufacturer',
          publisher: { '@id': `${siteUrl}/#organization` },
        },
        {
          // EEAT：站点技术内容的署名实体（团队署名）
          '@type': 'Organization',
          '@id': `${siteUrl}/about-us/#team`,
          name: 'XION Tech Team',
          description:
            'The production, quality-assurance and export team at XION / DinWeys Biotech that researches, writes and reviews the technical content on this site.',
          url: `${siteUrl}/about-us/`,
          parentOrganization: { '@id': `${siteUrl}/#organization` },
          knowsAbout: [
            'Potato flakes manufacturing',
            'Instant mashed potato (dehydrated) production',
            'Frozen french fries',
            'Potato starch',
            'Food safety certification (FSSC 22000, ISO 22000, HACCP, BRC)',
            'OEM / private-label packing',
          ],
        },
        {
          '@type': pageType,
          '@id': pageId,
          url: canonicalUrl,
          name: title,
          description: finalDesc,
          inLanguage: lang,
          isPartOf: { '@id': `${siteUrl}/#website` },
          about: { '@id': `${siteUrl}/#organization` },
        },
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonicalUrl}#breadcrumbs`,
          itemListElement: crumbList,
        },
        ...(faq && faq.length
          ? [
              {
                '@type': 'FAQPage',
                '@id': `${canonicalUrl}#faq`,
                inLanguage: lang,
                isPartOf: { '@id': `${siteUrl}/#website` },
                mainEntity: faq.map((f) => ({
                  '@type': 'Question',
                  name: f.q,
                  acceptedAnswer: { '@type': 'Answer', text: f.a },
                })),
              },
            ]
          : []),
      ],
    })} />
  </head>
  <body class="min-h-screen bg-white">
    <slot />
  </body>
</html>
