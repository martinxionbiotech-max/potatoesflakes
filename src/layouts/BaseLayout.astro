---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: string;
  canonical?: string;
}

const {
  title,
  description,
  image = '/default-og.png',
  type = 'website',
  canonical,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.potatoesflakes.com');
const siteUrl = site.toString().replace(/\/$/, '');
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : Astro.url.href;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} - XION Potato Flakes Manufacturer</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="XION Potato Flakes Manufacturer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Organization JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'XION Potato Flakes Manufacturer',
      alternateName: 'DinWeys Biotech Co., Ltd',
      url: siteUrl,
      logo: `${siteUrl}/wp-content/uploads/2026/06/logo.png`,
      contactPoint: {
        '@type': 'ContactPoint',
        telephone: '+86 400-633-0616',
        contactType: 'sales',
        email: 'Ashelyhongjigroupllc@gmail.com',
      },
      address: {
        '@type': 'PostalAddress',
        streetAddress: '3# building, high tech new town, North Silicon Valley Qiaodong District',
        addressLocality: 'Zhangjiakou City',
        addressRegion: 'Hebei',
        addressCountry: 'CN',
      },
      sameAs: [],
    })} />
  </head>
  <body class="min-h-screen bg-white">
    <slot />
  </body>
</html>
