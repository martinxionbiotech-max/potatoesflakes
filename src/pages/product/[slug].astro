---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { formatPriceRange, getPriceRange } from '../../pricing';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const price = getPriceRange(product.data.category);

const siteUrl = 'https://www.potatoesflakes.com';
const productUrl = `${siteUrl}/product/${product.slug}/`;
// 主图 + 图库（图库字段不含 /wp-content 前缀）
const productImages = [
  product.data.image,
  ...(product.data.gallery ?? []).map((g) => `/wp-content/${g}`),
]
  .filter(Boolean)
  .map((p) => (p!.startsWith('http') ? p! : `${siteUrl}${p}`));

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${productUrl}#product`,
  name: product.data.title,
  url: productUrl,
  description: product.data.description,
  sku: product.data.sku || undefined,
  image: productImages.length > 0 ? productImages : undefined,
  category: product.data.categoryName,
  brand: {
    '@type': 'Brand',
    '@id': `${siteUrl}/#brand`,
    name: 'XION',
  },
  manufacturer: { '@id': `${siteUrl}/#organization` },
  mainEntityOfPage: { '@id': `${productUrl}#webpage` },
  // B2B：面向食品厂/分销商/OEM 采购方
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Food manufacturers, importers, distributors and OEM / private-label buyers',
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Product category', value: product.data.categoryName },
    {
      '@type': 'PropertyValue',
      name: 'Supply model',
      value: 'Bulk B2B supply by quotation — MOQ, packaging and lead time on request',
    },
  ].concat(
    price
      ? [
          {
            '@type': 'PropertyValue',
            name: 'Reference price range',
            value: formatPriceRange(price),
          },
        ]
      : [],
  ),
  // B2B 询单模式：已公布参考价格区间的分类用 AggregateOffer（GSC 商家信息要求数值价格），
  // 未公布价格的分类保留询单型 Offer（不带 price，不编造）。
  offers: price
    ? {
        '@type': 'AggregateOffer',
        '@id': `${productUrl}#offer`,
        url: productUrl,
        priceCurrency: 'USD',
        lowPrice: price.low,
        highPrice: price.high,
        // GSC「应指定 price 或 priceSpecification.price（在 offers 中）」：
        // AggregateOffer 的 lowPrice/highPrice 不被该验证接受，需显式给出 priceSpecification.price。
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: price.low,
          minPrice: price.low,
          maxPrice: price.high,
          priceCurrency: 'USD',
          unitText: price.unit,
        },
        availability: 'https://schema.org/InStock',
        itemCondition: 'https://schema.org/NewCondition',
        businessFunction: 'http://purl.org/goodrelations/v1#Sell',
        seller: { '@id': `${siteUrl}/#organization` },
      }
    : {
        '@type': 'Offer',
        '@id': `${productUrl}#offer`,
        url: `${siteUrl}/contact/`,
        availability: 'https://schema.org/InStock',
        itemCondition: 'https://schema.org/NewCondition',
        businessFunction: 'http://purl.org/goodrelations/v1#Sell',
        seller: { '@id': `${siteUrl}/#organization` },
      },
};
---

<BaseLayout
  title={product.data.title}
  description={product.data.description}
  image={product.data.image}
  type="product"
  canonical={`/product/${product.slug}/`}
  pageType="ItemPage"
  crumbName={product.data.title}
  breadcrumbs={[
    { name: 'Product', href: '/product/' },
    { name: product.data.categoryName, href: `/product-category/${product.data.category}/` },
  ]}
>
  <Header />
  <article class="container-x py-12">
    <!-- 面包屑 -->
    <nav class="mb-6 text-sm text-gray-500">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/product/" class="hover:text-brand-600">Product</a>
      <span class="mx-2">/</span>
      <a href={`/product-category/${product.data.category}/`} class="hover:text-brand-600">{product.data.categoryName}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{product.data.title}</span>
    </nav>

    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        {product.data.image ? (
          <img src={product.data.image} alt={product.data.title} class="w-full rounded-2xl shadow-lg" loading="eager" />
        ) : null}
        {product.data.gallery && product.data.gallery.length > 0 && (
          <div class="mt-4 grid grid-cols-4 gap-3">
            {product.data.gallery.map((g) => (
              <img src={`/wp-content/${g}`} alt={product.data.title} class="aspect-square w-full rounded-lg object-cover" loading="lazy" />
            ))}
          </div>
        )}
      </div>
      <div>
        <h1 class="text-3xl font-bold text-gray-900">{product.data.title}</h1>
        {product.data.sku && <p class="mt-2 text-sm text-gray-500">SKU: {product.data.sku}</p>}
        <div class="mt-6 flex gap-3">
          <a href="/contact/" class="btn-primary">Get a Quote</a>
          <a href="/services/" class="btn-ghost">OEM / Customization</a>
        </div>
        {
          price && (
            <p class="mt-4 text-sm text-gray-600">
              <span class="font-semibold text-gray-900">Reference price:</span>{' '}
              USD {price.low.toLocaleString('en-US')}–{price.high.toLocaleString('en-US')} {price.unit}{price.moq ? ` (${price.moq})` : ''} — final
              quotation on request.
            </p>
          )
        }
        <div class="prose prose-lg mt-8 max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <Footer />
</BaseLayout>
