---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const siteUrl = 'https://www.potatoesflakes.com';
const productUrl = `${siteUrl}/product/${product.slug}/`;
// 主图 + 图库（图库字段不含 /wp-content 前缀）
const productImages = [
  product.data.image,
  ...(product.data.gallery ?? []).map((g) => `/wp-content/${g}`),
]
  .filter(Boolean)
  .map((p) => (p!.startsWith('http') ? p! : `${siteUrl}${p}`));

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${productUrl}#product`,
  name: product.data.title,
  url: productUrl,
  description: product.data.description,
  sku: product.data.sku || undefined,
  image: productImages.length > 0 ? productImages : undefined,
  category: product.data.categoryName,
  brand: {
    '@type': 'Brand',
    '@id': `${siteUrl}/#brand`,
    name: 'XION',
  },
  manufacturer: { '@id': `${siteUrl}/#organization` },
  mainEntityOfPage: { '@id': `${productUrl}#webpage` },
  // B2B：面向食品厂/分销商/OEM 采购方
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Food manufacturers, importers, distributors and OEM / private-label buyers',
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Product category', value: product.data.categoryName },
    {
      '@type': 'PropertyValue',
      name: 'Supply model',
      value: 'Bulk B2B supply by quotation — MOQ, packaging and lead time on request',
    },
  ],
  // 询单模式（站点无在线定价：购物车页明确说明为静态产品目录，需联系报价）
  offers: {
    '@type': 'Offer',
    '@id': `${productUrl}#offer`,
    url: `${siteUrl}/contact/`,
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    businessFunction: 'http://purl.org/goodrelations/v1#Sell',
    seller: { '@id': `${siteUrl}/#organization` },
  },
};
---

<BaseLayout
  title={product.data.title}
  description={product.data.description}
  image={product.data.image}
  type="product"
  canonical={`/product/${product.slug}/`}
  pageType="ItemPage"
  crumbName={product.data.title}
  breadcrumbs={[
    { name: 'Product', href: '/product/' },
    { name: product.data.categoryName, href: `/product-category/${product.data.category}/` },
  ]}
>
  <Header />
  <article class="container-x py-12">
    <!-- 面包屑 -->
    <nav class="mb-6 text-sm text-gray-500">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/product/" class="hover:text-brand-600">Product</a>
      <span class="mx-2">/</span>
      <a href={`/product-category/${product.data.category}/`} class="hover:text-brand-600">{product.data.categoryName}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{product.data.title}</span>
    </nav>

    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        {product.data.image ? (
          <img src={product.data.image} alt={product.data.title} class="w-full rounded-2xl shadow-lg" loading="eager" />
        ) : null}
        {product.data.gallery && product.data.gallery.length > 0 && (
          <div class="mt-4 grid grid-cols-4 gap-3">
            {product.data.gallery.map((g) => (
              <img src={`/wp-content/${g}`} alt={product.data.title} class="aspect-square w-full rounded-lg object-cover" loading="lazy" />
            ))}
          </div>
        )}
      </div>
      <div>
        <h1 class="text-3xl font-bold text-gray-900">{product.data.title}</h1>
        {product.data.sku && <p class="mt-2 text-sm text-gray-500">SKU: {product.data.sku}</p>}
        <div class="mt-6 flex gap-3">
          <a href="/contact/" class="btn-primary">Get a Quote</a>
          <a href="/services/" class="btn-ghost">OEM / Customization</a>
        </div>
        <div class="prose prose-lg mt-8 max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <Footer />
</BaseLayout>
