---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products')).sort((a, b) => a.data.title.localeCompare(b.data.title));
// 分类分组
const categories = [
  { slug: 'instant-mashed-potato', name: 'Instant Mashed Potatoes OEM' },
  { slug: 'potato-flakes', name: 'Potato Flakes' },
  { slug: 'frozen-french-fries', name: 'Frozen French Fries' },
  { slug: 'seed-potatoes', name: 'Seed Potatoes' },
  { slug: 'potato-starch', name: 'Potato Starch' },
];
---

<BaseLayout
  title="Products"
  description="Browse XION's complete range of potato flakes, instant mashed potatoes, frozen french fries, seed potatoes and potato starch."
>
  <Header />
  <section class="container-x py-14">
    <h1 class="text-3xl font-bold text-gray-900">Products</h1>
    <p class="mt-2 text-gray-600">Potato flakes and flavored instant mashed potatoes are our core products.</p>

    {categories.map((cat) => {
      const items = products.filter((p) => p.data.category === cat.slug);
      if (items.length === 0) return null;
      return (
        <div class="mt-12">
          <h2 class="mb-5 text-xl font-semibold text-gray-900">{cat.name}</h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {items.map((p) => (
              <a href={`/product/${p.slug}/`} class="card-hover group overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-100">
                <div class="aspect-square overflow-hidden bg-gray-100">
                  {p.data.image ? (
                    <img src={p.data.image} alt={p.data.title} class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
                  ) : (
                    <div class="flex h-full items-center justify-center text-gray-400">No image</div>
                  )}
                </div>
                <div class="p-4">
                  <h3 class="text-sm font-semibold text-gray-900 group-hover:text-brand-700">{p.data.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </section>
  <Footer />
</BaseLayout>
