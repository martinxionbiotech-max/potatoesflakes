---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categories = [
    { slug: 'instant-mashed-potato', name: 'Bulk Instant Mashed Potatoes OEM', desc: 'Flavored instant mashed potato powder for OEM supply. Multiple flavors and packaging customization.' },
    { slug: 'potato-flakes', name: 'Bulk Potato Flakes', desc: 'We are a manufacturer of potato flakes located in Hebei Province, China. We have an annual production capacity of 10,000 tons.' },
    { slug: 'frozen-french-fries', name: 'Frozen French Fries', desc: 'Crinkle cut and straight cut frozen french fries, manufacturer direct supply.' },
    { slug: 'seed-potatoes', name: 'Seed Potatoes', desc: 'High-quality seed potatoes for sale, popular China potato seed varieties.' },
    { slug: 'potato-starch', name: 'Potato Starch', desc: 'Unmodified potato starch in bulk, native manufacturer from Hebei, China.' },
  ];
  const products = await getCollection('products');
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { cat, products: products.filter((p) => p.data.category === cat.slug) },
  }));
}

const { cat, products } = Astro.props;
---

<BaseLayout title={cat.name} description={cat.desc}>
  <Header />
  <section class="container-x py-14">
    <nav class="mb-4 text-sm text-gray-500">
      <a href="/" class="hover:text-brand-600">Home</a>
      <span class="mx-2">/</span>
      <a href="/product/" class="hover:text-brand-600">Product</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{cat.name}</span>
    </nav>
    <h1 class="text-3xl font-bold text-gray-900">{cat.name}</h1>
    <p class="mt-2 max-w-2xl text-gray-600">{cat.desc}</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {products.map((p) => (
        <a href={`/product/${p.slug}/`} class="card-hover group overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-100">
          <div class="aspect-square overflow-hidden bg-gray-100">
            {p.data.image ? (
              <img src={p.data.image} alt={p.data.title} class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
            ) : (
              <div class="flex h-full items-center justify-center text-gray-400">No image</div>
            )}
          </div>
          <div class="p-4">
            <h2 class="text-sm font-semibold text-gray-900 group-hover:text-brand-700">{p.data.title}</h2>
          </div>
        </a>
      ))}
    </div>
  </section>
  <Footer />
</BaseLayout>
