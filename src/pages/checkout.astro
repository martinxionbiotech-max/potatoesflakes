---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Checkout"
  description="Checkout - XION Potato Flakes Manufacturer"
>
  <Header />
  <section class="container-x py-20 text-center">
    <h1 class="text-3xl font-bold text-gray-900">Checkout</h1>
    <p class="mx-auto mt-4 max-w-xl text-gray-600">
      This is a static product catalog. For bulk orders, OEM, and customized potato flakes or instant mashed potatoes, please contact us directly.
    </p>
    <a href="/contact/" class="btn-primary mt-8">Contact Us for a Quote</a>
  </section>
  <Footer />
</BaseLayout>
