---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { LANGUAGES } from '../../languages';
import { UI } from '../../ui';

export async function getStaticPaths() {
  return LANGUAGES.map((l) => ({
    params: { lang: l.code },
    props: { lang: l },
  }));
}

const { lang } = Astro.props;
const prefix = `/${lang.code}`;
const ui = UI[lang.code];
const home = ui.homePage;

// 当前语言的翻译版产品（title/description 已翻译）
const products = (await getCollection(`${lang.code}_products`)).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
);
// 首页精选产品（与英文首页一致的 8 个）
const featuredSlugs = [
  'unmodified-potato-starch-hebei-china-native-manufacturer',
  '2025-super-cheap-black-spot-potato-flakes',
  'red-seed-potatoes-for-sale-china-popular-potato-seeds',
  'potato-flakes-for-fish-bait-and-animal-feed',
  'bulk-french-fries-frozen-manufacturer-direct-mccain-potato',
  'french-fries-crinkle-cut-2kg-bag',
  '1-4-frozen-french-fries-zhongda-meicheng-one-quarter-size',
  '3-8-frozen-french-fries-zhongda-meicheng',
];
const featured = featuredSlugs
  .map((slug) => products.find((p) => p.slug === slug))
  .filter(Boolean);
---

<BaseLayout
  title="Potato Flakes Manufacturer & Supplier in China"
  description="Xion is a top manufacturer specializing in the development and customization of potato flakes products and customized mashed potatoes."
  image="/wp-content/uploads/2024/03/organic-potato-hero.webp"
  lang={lang.htmlLang}
  locale={lang.ogLocale}
  canonical={`/${lang.code}/`}
  currentLang={lang.code}
  relPath=""
>
  <Header lang={lang.code} />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-brand-100">
    <div class="container-x grid items-center gap-10 py-20 lg:grid-cols-2 lg:py-28">
      <div class="fade-in-up">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-600">
          {home.heroEyebrow}
        </p>
        <h1 class="text-4xl font-bold leading-tight text-gray-900 sm:text-5xl">
          {home.heroTitle}
        </h1>
        <p class="mt-4 text-lg text-gray-600">
          {home.heroSub}
        </p>
        <div class="mt-8 flex gap-3">
          <a href={`${prefix}/contact/`} class="btn-primary">{home.contactUsNow}</a>
          <a href={`${prefix}/product/`} class="btn-ghost">{home.viewProducts}</a>
        </div>
      </div>
      <div class="fade-in-up" style="animation-delay:.15s">
        <img
          src="/wp-content/uploads/2024/03/organic-potato-hero.webp"
          alt="Bulk Potato Flakes"
          class="mx-auto rounded-2xl shadow-xl"
          width="600"
          height="600"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="border-y border-gray-100 bg-white">
    <div class="container-x grid grid-cols-2 gap-6 py-10 text-center md:grid-cols-4">
      {[
        { title: home.trust1Title, sub: home.trust1Sub },
        { title: home.trust2Title, sub: home.trust2Sub },
        { title: home.trust3Title, sub: home.trust3Sub },
        { title: home.trust4Title, sub: home.trust4Sub },
      ].map((item) => (
        <div>
          <div class="text-lg font-bold text-brand-700">{item.title}</div>
          <div class="mt-1 text-sm text-gray-500">{item.sub}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- About -->
  <section class="container-x py-20">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="prose prose-lg max-w-none">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">{home.aboutEyebrow}</p>
        <h2 class="mt-2 text-3xl font-bold text-gray-900">{home.aboutTitle}</h2>
        <p class="mt-4 text-gray-600">
          {home.aboutP1}
        </p>
        <p class="text-gray-600">
          {home.aboutP2}
        </p>
        <a href={`${prefix}/about-us/`} class="btn-primary mt-6">{home.learnMore}</a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <img src="/wp-content/uploads/2024/03/mashed-Potato-factory--300x225.jpg" alt="Mashed potato factory" class="card-hover rounded-xl" loading="lazy" />
        <img src="/wp-content/uploads/2024/03/44-300x201.jpg" alt="Potato Flakes Production" class="card-hover rounded-xl" loading="lazy" />
        <img src="/wp-content/uploads/2024/03/46-300x205.jpg" alt="Potato flakes production line" class="card-hover rounded-xl" loading="lazy" />
        <img src="/wp-content/uploads/2024/03/34-300x191.jpg" alt="Potato planting base" class="card-hover rounded-xl" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Featured products -->
  <section class="bg-gray-50 py-20">
    <div class="container-x">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-bold text-gray-900">{home.ourProducts}</h2>
        <p class="mt-2 text-gray-600">{home.ourProductsSub}</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((p) => (
          <a href={`${prefix}/product/${p.slug}/`} class="card-hover group overflow-hidden rounded-xl bg-white shadow-sm">
            <div class="aspect-square overflow-hidden bg-gray-100">
              {p.data.image ? (
                <img src={p.data.image} alt={p.data.title} class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
              ) : (
                <div class="flex h-full items-center justify-center text-gray-400">No image</div>
              )}
            </div>
            <div class="p-4">
              <h3 class="text-sm font-semibold text-gray-900 group-hover:text-brand-700">{p.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href={`${prefix}/product/`} class="btn-primary">{home.viewAllProducts}</a>
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="container-x py-20">
    <div class="mb-10 text-center">
      <h2 class="text-3xl font-bold text-gray-900">{home.whyChooseUs}</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {[
        { title: home.why1Title, sub: home.why1Sub },
        { title: home.why2Title, sub: home.why2Sub },
        { title: home.why3Title, sub: home.why3Sub },
      ].map((item) => (
        <div class="card-hover rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-gray-900">{item.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{item.sub}</p>
        </div>
      ))}
    </div>
  </section>

  <Footer lang={lang.code} />
</BaseLayout>
