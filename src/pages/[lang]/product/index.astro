---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
import { LANGUAGES } from '../../../languages';
import { UI } from '../../../ui';

export async function getStaticPaths() {
  const paths = [];
  for (const l of LANGUAGES) {
    paths.push({ params: { lang: l.code }, props: { lang: l } });
  }
  return paths;
}

const { lang } = Astro.props;
const ui = UI[lang.code];
const products = (await getCollection(`${lang.code}_products`)).sort((a, b) => a.data.title.localeCompare(b.data.title));
const categories = Object.entries(ui.productCategories).map(([slug, c]) => ({ slug, ...c }));
---

<BaseLayout
  title={ui.products}
  description={ui.productsIntro}
  lang={lang.htmlLang}
  locale={lang.ogLocale}
  canonical={`/${lang.code}/product/`}
  currentLang={lang.code}
  relPath="product/"
>
  <Header lang={lang.code} />
  <section class="container-x py-14">
    <h1 class="text-3xl font-bold text-gray-900">{ui.products}</h1>
    <p class="mt-2 text-gray-600">{ui.productsIntro}</p>

    {categories.map((cat) => {
      const items = products.filter((p) => p.data.category === cat.slug);
      if (items.length === 0) return null;
      return (
        <div class="mt-12">
          <h2 class="mb-5 text-xl font-semibold text-gray-900">{cat.name}</h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {items.map((p) => (
              <a href={`/${lang.code}/product/${p.id}/`} class="card-hover group overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-100">
                <div class="aspect-square overflow-hidden bg-gray-100">
                  {p.data.image ? (
                    <img src={p.data.image} alt={p.data.title} class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
                  ) : (
                    <div class="flex h-full items-center justify-center text-gray-400">{ui.noImage}</div>
                  )}
                </div>
                <div class="p-4">
                  <h3 class="text-sm font-semibold text-gray-900 group-hover:text-brand-700">{p.data.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      );
    })}
  </section>
  <Footer lang={lang.code} />
</BaseLayout>
