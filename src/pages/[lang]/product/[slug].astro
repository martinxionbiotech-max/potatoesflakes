---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { formatPriceRange, getPriceRange } from '../../../pricing';
import { LANGUAGES, getLang } from '../../../languages';
import { UI } from '../../../ui';

export async function getStaticPaths() {
  const paths = [];
  for (const l of LANGUAGES) {
    const products = await getCollection(`${l.code}_products`);
    for (const product of products) {
      paths.push({
        params: { lang: l.code, slug: product.id },
        props: { product, lang: l },
      });
    }
  }
  return paths;
}

const { product, lang } = Astro.props;
const { Content } = await render(product);
const ui = UI[lang.code];

const price = getPriceRange(product.data.category);

const siteUrl = 'https://potatoesflakes.com';
const productUrl = `${siteUrl}/${lang.code}/product/${product.id}/`;
const productImages = [
  product.data.image,
  ...(product.data.gallery ?? []).map((g) => `/wp-content/${g}`),
]
  .filter(Boolean)
  .map((p) => (p!.startsWith('http') ? p! : `${siteUrl}${p}`));

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  '@id': `${productUrl}#product`,
  name: product.data.title,
  url: productUrl,
  description: product.data.description,
  sku: product.data.sku || undefined,
  image: productImages.length > 0 ? productImages : undefined,
  category: product.data.categoryName,
  brand: {
    '@type': 'Brand',
    '@id': `${siteUrl}/#brand`,
    name: 'XION',
  },
  manufacturer: { '@id': `${siteUrl}/#organization` },
  mainEntityOfPage: { '@id': `${productUrl}#webpage` },
  audience: {
    '@type': 'BusinessAudience',
    audienceType: 'Food manufacturers, importers, distributors and OEM / private-label buyers',
  },
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Product category', value: product.data.categoryName },
    {
      '@type': 'PropertyValue',
      name: 'Supply model',
      value: 'Bulk B2B supply by quotation — MOQ, packaging and lead time on request',
    },
  ].concat(
    price
      ? [
          {
            '@type': 'PropertyValue',
            name: 'Reference price range',
            value: formatPriceRange(price),
          },
        ]
      : [],
  ),
  // B2B 询单模式：已公布参考价格区间的分类用 AggregateOffer（GSC 商家信息要求数值价格），
  // 未公布价格的分类保留询单型 Offer（不带 price，不编造）。
  offers: price
    ? {
        '@type': 'AggregateOffer',
        '@id': `${productUrl}#offer`,
        url: productUrl,
        priceCurrency: 'USD',
        lowPrice: price.low,
        highPrice: price.high,
        // GSC「应指定 price 或 priceSpecification.price（在 offers 中）」：
        // AggregateOffer 的 lowPrice/highPrice 不被该验证接受，需显式给出 priceSpecification.price。
        priceSpecification: {
          '@type': 'UnitPriceSpecification',
          price: price.low,
          minPrice: price.low,
          maxPrice: price.high,
          priceCurrency: 'USD',
          unitText: price.unit,
        },
        availability: 'https://schema.org/InStock',
        itemCondition: 'https://schema.org/NewCondition',
        businessFunction: 'http://purl.org/goodrelations/v1#Sell',
        seller: { '@id': `${siteUrl}/#organization` },
      }
    : {
        '@type': 'Offer',
        '@id': `${productUrl}#offer`,
        url: `${siteUrl}/${lang.code}/contact/`,
        availability: 'https://schema.org/InStock',
        itemCondition: 'https://schema.org/NewCondition',
        businessFunction: 'http://purl.org/goodrelations/v1#Sell',
        seller: { '@id': `${siteUrl}/#organization` },
      },
};
---

<BaseLayout
  title={product.data.title}
  description={product.data.description}
  image={product.data.image}
  type="product"
  lang={lang.htmlLang}
  locale={lang.ogLocale}
  canonical={`/${lang.code}/product/${product.id}/`}
  currentLang={lang.code}
  relPath={`product/${product.id}/`}
  pageType="ItemPage"
  crumbName={product.data.title}
  breadcrumbs={[
    { name: ui.products, href: `/${lang.code}/product/` },
    { name: product.data.categoryName, href: `/${lang.code}/product-category/${product.data.category}/` },
  ]}
>
  <Header lang={lang.code} />
  <article class="container-x py-12">
    <nav class="mb-6 text-sm text-gray-500">
      <a href={`/${lang.code}/`} class="hover:text-brand-600">{ui.home}</a>
      <span class="mx-2">/</span>
      <a href={`/${lang.code}/product/`} class="hover:text-brand-600">{ui.products}</a>
      <span class="mx-2">/</span>
      <a href={`/${lang.code}/product-category/${product.data.category}/`} class="hover:text-brand-600">{product.data.categoryName}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{product.data.title}</span>
    </nav>

    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        {product.data.image ? (
          <img src={product.data.image} alt={product.data.title} class="w-full rounded-2xl shadow-lg" loading="eager" />
        ) : null}
        {product.data.gallery && product.data.gallery.length > 0 && (
          <div class="mt-4 grid grid-cols-4 gap-3">
            {product.data.gallery.map((g) => (
              <img src={`/wp-content/${g}`} alt={product.data.title} class="aspect-square w-full rounded-lg object-cover" loading="lazy" />
            ))}
          </div>
        )}
      </div>
      <div>
        <h1 class="text-3xl font-bold text-gray-900">{product.data.title}</h1>
        {product.data.sku && <p class="mt-2 text-sm text-gray-500">{ui.skuLabel}: {product.data.sku}</p>}
        <div class="mt-6 flex gap-3">
          <a href={`/${lang.code}/contact/`} class="btn-primary">{ui.requestQuote}</a>
          <a href={`/${lang.code}/services/`} class="btn-ghost">{ui.oemCustom}</a>
        </div>
        {
          price && (
            <p class="mt-4 text-sm text-gray-600">
              <span class="font-semibold text-gray-900">{ui.referencePrice}:</span>{' '}
              USD {price.low.toLocaleString('en-US')}–{price.high.toLocaleString('en-US')} {price.unit}{price.moq ? ` (${price.moq})` : ''} — {ui.quoteNote}.
            </p>
          )
        }
        <div class="prose prose-lg mt-8 max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <Footer lang={lang.code} />
</BaseLayout>
