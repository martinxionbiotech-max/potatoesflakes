---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { LANGUAGES, getLang } from '../../../languages';
import { UI } from '../../../ui';

export async function getStaticPaths() {
  const paths = [];
  for (const l of LANGUAGES) {
    const products = await getCollection(`${l.code}_products`);
    for (const product of products) {
      paths.push({
        params: { lang: l.code, slug: product.id },
        props: { product, lang: l },
      });
    }
  }
  return paths;
}

const { product, lang } = Astro.props;
const { Content } = await render(product);
const ui = UI[lang.code];

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.data.title,
  description: product.data.description,
  sku: product.data.sku || undefined,
  image: product.data.image ? `https://www.potatoesflakes.com${product.data.image}` : undefined,
  brand: {
    '@type': 'Brand',
    name: 'XION',
  },
  category: product.data.categoryName,
};
---

<BaseLayout
  title={product.data.title}
  description={product.data.description}
  image={product.data.image}
  type="product"
  lang={lang.htmlLang}
  locale={lang.ogLocale}
  canonical={`/${lang.code}/product/${product.id}/`}
  currentLang={lang.code}
  relPath={`product/${product.id}/`}
>
  <Header lang={lang.code} />
  <article class="container-x py-12">
    <nav class="mb-6 text-sm text-gray-500">
      <a href={`/${lang.code}/`} class="hover:text-brand-600">{ui.home}</a>
      <span class="mx-2">/</span>
      <a href={`/${lang.code}/product/`} class="hover:text-brand-600">{ui.products}</a>
      <span class="mx-2">/</span>
      <a href={`/${lang.code}/product-category/${product.data.category}/`} class="hover:text-brand-600">{product.data.categoryName}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{product.data.title}</span>
    </nav>

    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        {product.data.image ? (
          <img src={product.data.image} alt={product.data.title} class="w-full rounded-2xl shadow-lg" loading="eager" />
        ) : null}
        {product.data.gallery && product.data.gallery.length > 0 && (
          <div class="mt-4 grid grid-cols-4 gap-3">
            {product.data.gallery.map((g) => (
              <img src={`/wp-content/${g}`} alt={product.data.title} class="aspect-square w-full rounded-lg object-cover" loading="lazy" />
            ))}
          </div>
        )}
      </div>
      <div>
        <h1 class="text-3xl font-bold text-gray-900">{product.data.title}</h1>
        {product.data.sku && <p class="mt-2 text-sm text-gray-500">{ui.skuLabel}: {product.data.sku}</p>}
        <div class="mt-6 flex gap-3">
          <a href={`/${lang.code}/contact/`} class="btn-primary">{ui.requestQuote}</a>
          <a href={`/${lang.code}/services/`} class="btn-ghost">{ui.oemCustom}</a>
        </div>
        <div class="prose prose-lg mt-8 max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
  <Footer lang={lang.code} />
</BaseLayout>
