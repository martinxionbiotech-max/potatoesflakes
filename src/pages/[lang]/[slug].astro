---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';
import { LANGUAGES } from '../../languages';
import { UI } from '../../ui';

export async function getStaticPaths() {
  const paths = [];
  for (const l of LANGUAGES) {
    const pages = await getCollection(`${l.code}_pages`);
    for (const page of pages) {
      paths.push({
        params: { lang: l.code, slug: page.id },
        props: { page, lang: l },
      });
    }
  }
  return paths;
}

const { page, lang } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  type="website"
  lang={lang.htmlLang}
  locale={lang.ogLocale}
  canonical={`/${lang.code}/${page.id}/`}
  currentLang={lang.code}
  relPath={`${page.id}/`}
>
  <Header lang={lang.code} />
  <article class="container-x py-12">
    <div class="mx-auto max-w-4xl">
      <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">{page.data.title}</h1>
      <div class="prose prose-lg mt-8 max-w-none">
        <Content />
      </div>
    </div>
  </article>
  <Footer lang={lang.code} />
</BaseLayout>
