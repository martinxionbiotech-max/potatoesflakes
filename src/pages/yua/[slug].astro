---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = await getCollection('yua_pages');
  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  type="website"
  lang="zh-Hant"
  locale="zh_Hant_HK"
  canonical={`/yua/${page.id}/`}
>
  <Header />
  <article class="container-x py-12">
    <div class="mx-auto max-w-4xl">
      <h1 class="text-3xl font-bold text-gray-900 sm:text-4xl">{page.data.title}</h1>
      <div class="prose prose-lg mt-8 max-w-none">
        <Content />
      </div>
    </div>
  </article>
  <Footer />
</BaseLayout>
