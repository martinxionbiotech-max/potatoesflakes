---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('yua_blog')).sort((a, b) => {
  const da = a.data.pubDate || '0';
  const db = b.data.pubDate || '0';
  return db.localeCompare(da);
});
---

<BaseLayout
  title="博客"
  description="XION 薯粉片製造商提供嘅專業指南：薯粉片、即食薯蓉、食譜及行業見解。"
  lang="zh-Hant"
  locale="zh_Hant_HK"
>
  <Header />
  <section class="container-x py-14">
    <h1 class="text-3xl font-bold text-gray-900">博客</h1>
    <p class="mt-2 text-gray-600">薯粉片指南、食譜及行業見解。</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/yua/blog/${post.id}/`} class="card-hover group overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-100">
          <div class="aspect-video overflow-hidden bg-gray-100">
            {post.data.image ? (
              <img src={post.data.image} alt={post.data.title} class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
            ) : (
              <div class="flex h-full items-center justify-center text-gray-400">沒有圖片</div>
            )}
          </div>
          <div class="p-5">
            {post.data.pubDate && <p class="text-xs text-gray-400">{post.data.pubDate}</p>}
            <h2 class="mt-1 line-clamp-2 text-base font-semibold text-gray-900 group-hover:text-brand-700">{post.data.title}</h2>
          </div>
        </a>
      ))}
    </div>
  </section>
  <Footer />
</BaseLayout>
