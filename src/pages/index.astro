---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products')).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
// 首页精选产品（原站展示的 8 个）
const featuredSlugs = [
  'unmodified-potato-starch-hebei-china-native-manufacturer',
  '2025-super-cheap-black-spot-potato-flakes',
  'red-seed-potatoes-for-sale-china-popular-potato-seeds',
  'potato-flakes-for-fish-bait-and-animal-feed',
  'bulk-french-fries-frozen-manufacturer-direct-mccain-potato',
  'french-fries-crinkle-cut-2kg-bag',
  '1-4-frozen-french-fries-zhongda-meicheng-one-quarter-size',
  '3-8-frozen-french-fries-zhongda-meicheng',
];
const featured = featuredSlugs
  .map((slug) => products.find((p) => p.slug === slug))
  .filter(Boolean);
---

<BaseLayout
  title="Potato Flakes Manufacturer & Supplier in China"
  description="Xion is a top manufacturer specializing in the development and customization of potato flakes products and customized mashed potatoes."
  image="/wp-content/uploads/2024/03/organic-potato-hero.webp"
>
  <Header />

  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-brand-100">
    <div class="container-x grid items-center gap-10 py-20 lg:grid-cols-2 lg:py-28">
      <div class="fade-in-up">
        <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-brand-600">
          The Top Chinese Supplier
        </p>
        <h1 class="text-4xl font-bold leading-tight text-gray-900 sm:text-5xl">
          Bulk Potato Flakes &amp; Instant Mashed Potato
        </h1>
        <p class="mt-4 text-lg text-gray-600">
          Providing Customized High-Quality Instant Mashed Potato Products. Competitive Prices, Superior Service.
        </p>
        <div class="mt-8 flex gap-3">
          <a href="/contact/" class="btn-primary">Contact Us Now</a>
          <a href="/product/" class="btn-ghost">View Products</a>
        </div>
      </div>
      <div class="fade-in-up" style="animation-delay:.15s">
        <img
          src="/wp-content/uploads/2024/03/organic-potato-hero.webp"
          alt="Bulk Potato Flakes"
          class="mx-auto rounded-2xl shadow-xl"
          width="600"
          height="600"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Trust bar -->
  <section class="border-y border-gray-100 bg-white">
    <div class="container-x grid grid-cols-2 gap-6 py-10 text-center md:grid-cols-4">
      {[
        { title: 'Top-Quality', sub: 'Certified and Exporting to 20+ Countries' },
        { title: 'Flexible OEM', sub: 'Multiple Flavors and Packaging Sizes' },
        { title: 'Competitive Price', sub: 'Creating Greater Value Space for Clients' },
        { title: 'Excellent Services', sub: 'Our experts are available 24/7 to serve and solve' },
      ].map((item) => (
        <div>
          <div class="text-lg font-bold text-brand-700">{item.title}</div>
          <div class="mt-1 text-sm text-gray-500">{item.sub}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- About -->
  <section class="container-x py-20">
    <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
      <div class="prose prose-lg max-w-none">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">About XION</p>
        <h2 class="mt-2 text-3xl font-bold text-gray-900">A Large-Scale Potato Flakes &amp; Mashed Potato Manufacturer</h2>
        <p class="mt-4 text-gray-600">
          We are Xion Biotech Co., Ltd. (The company name was changed to Dingwei Biotech Co., Ltd. Trading name: DinWeys in 2024), a large-scale potato flakes and mashed potato manufacturer, as well as the supplier for Pepsi, Orion, and other brands, headquartered in Hebei, China.
        </p>
        <p class="text-gray-600">
          For over a decade, we have specialized in developing and customizing potato flake products. We have a fully certified food production factory and a product development and testing laboratory. Our high level of production processes and quality is confirmed by the FSSC 22000, FDA, ISO9001, Halal, Kosher certificates, and the TR CU 021 Declaration of Compliance.
        </p>
        <a href="/about-us/" class="btn-primary mt-6">Learn More About Us</a>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <img src="/wp-content/uploads/2024/03/mashed-Potato-factory--300x225.jpg" alt="Mashed potato factory" class="card-hover rounded-xl" loading="lazy" />
        <img src="/wp-content/uploads/2024/03/44-300x201.jpg" alt="Potato Flakes Production" class="card-hover rounded-xl" loading="lazy" />
        <img src="/wp-content/uploads/2024/03/46-300x205.jpg" alt="Potato flakes production line" class="card-hover rounded-xl" loading="lazy" />
        <img src="/wp-content/uploads/2024/03/34-300x191.jpg" alt="Potato planting base" class="card-hover rounded-xl" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Featured products -->
  <section class="bg-gray-50 py-20">
    <div class="container-x">
      <div class="mb-10 text-center">
        <h2 class="text-3xl font-bold text-gray-900">Our Products</h2>
        <p class="mt-2 text-gray-600">Potato flakes, instant mashed potatoes, french fries, seed potatoes &amp; potato starch</p>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((p) => (
          <a href={`/product/${p.slug}/`} class="card-hover group overflow-hidden rounded-xl bg-white shadow-sm">
            <div class="aspect-square overflow-hidden bg-gray-100">
              {p.data.image ? (
                <img src={p.data.image} alt={p.data.title} class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
              ) : (
                <div class="flex h-full items-center justify-center text-gray-400">No image</div>
              )}
            </div>
            <div class="p-4">
              <h3 class="text-sm font-semibold text-gray-900 group-hover:text-brand-700">{p.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
      <div class="mt-10 text-center">
        <a href="/product/" class="btn-primary">View All Products</a>
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="container-x py-20">
    <div class="mb-10 text-center">
      <h2 class="text-3xl font-bold text-gray-900">Why Choose Us</h2>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {[
        { title: 'Customized Design Solutions', sub: 'Professional services for the customized development and production of flavored instant mashed potato products to meet client specifications and preferences.' },
        { title: 'Convenient International Export', sub: 'One of the few Chinese factories registered and qualified to export potato flakes and instant mashed potatoes. We make the process simple for you.' },
        { title: 'Personalized Experience and More Choices', sub: 'Most potato flour factories do not offer sample and small batch order services, but we can do it to meet your business development needs.' },
      ].map((item) => (
        <div class="card-hover rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-gray-900">{item.title}</h3>
          <p class="mt-2 text-sm text-gray-600">{item.sub}</p>
        </div>
      ))}
    </div>
  </section>

  <Footer />
</BaseLayout>
