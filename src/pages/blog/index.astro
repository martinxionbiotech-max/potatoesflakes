---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => {
  const da = a.data.pubDate || '0';
  const db = b.data.pubDate || '0';
  return db.localeCompare(da);
});
---

<BaseLayout
  title="Blog"
  description="Expert guides on potato flakes, instant mashed potatoes, recipes, and industry insights from XION Potato Flakes Manufacturer."
>
  <Header />
  <section class="container-x py-14">
    <h1 class="text-3xl font-bold text-gray-900">Blog</h1>
    <p class="mt-2 text-gray-600">Potato flakes guides, recipes and industry insights.</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="card-hover group overflow-hidden rounded-xl bg-white shadow-sm ring-1 ring-gray-100">
          <div class="aspect-video overflow-hidden bg-gray-100">
            {post.data.image ? (
              <img src={post.data.image} alt={post.data.title} class="h-full w-full object-cover transition duration-300 group-hover:scale-105" loading="lazy" />
            ) : (
              <div class="flex h-full items-center justify-center text-gray-400">No image</div>
            )}
          </div>
          <div class="p-5">
            {post.data.pubDate && <p class="text-xs text-gray-400">{post.data.pubDate}</p>}
            <h2 class="mt-1 line-clamp-2 text-base font-semibold text-gray-900 group-hover:text-brand-700">{post.data.title}</h2>
          </div>
        </a>
      ))}
    </div>
  </section>
  <Footer />
</BaseLayout>
