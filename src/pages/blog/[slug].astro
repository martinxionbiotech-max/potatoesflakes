---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const siteUrl = 'https://www.potatoesflakes.com';
const postUrl = `${siteUrl}/blog/${post.slug}/`;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${postUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  url: postUrl,
  image: post.data.image ? `${siteUrl}${post.data.image}` : undefined,
  datePublished: post.data.pubDate || undefined,
  inLanguage: 'en',
  articleSection: post.data.category || undefined,
  mainEntityOfPage: { '@id': `${postUrl}#webpage` },
  isPartOf: { '@id': `${siteUrl}/#website` },
  // 署名与发布方统一指向站内 Organization 实体（@id 复用），保证实体可解析
  author: { '@id': `${siteUrl}/#organization` },
  publisher: { '@id': `${siteUrl}/#organization` },
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  type="article"
  canonical={`/blog/${post.slug}/`}
  crumbName={post.data.title}
  breadcrumbs={[{ name: 'Blog', href: '/blog/' }]}
>
  <Header />
  <article class="container-x py-12">
    <div class="mx-auto max-w-3xl">
      <nav class="mb-6 text-sm text-gray-500">
        <a href="/" class="hover:text-brand-600">Home</a>
        <span class="mx-2">/</span>
        <a href="/blog/" class="hover:text-brand-600">Blog</a>
      </nav>
      <h1 class="text-3xl font-bold leading-tight text-gray-900 sm:text-4xl">{post.data.title}</h1>
      {post.data.pubDate && <p class="mt-3 text-sm text-gray-500">Published: {post.data.pubDate}</p>}
      {post.data.image && (
        <img src={post.data.image} alt={post.data.title} class="mt-6 w-full rounded-2xl shadow-md" loading="eager" />
      )}
      <div class="prose prose-lg mt-8 max-w-none">
        <Content />
      </div>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <Footer />
</BaseLayout>
