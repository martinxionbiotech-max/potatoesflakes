---
import { UI } from '../ui';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const ui = UI[lang || 'en'];
const prefix = lang && lang !== 'en' ? `/${lang}` : '';
const nav = [
  { key: 'home', href: `${prefix}/` },
  { key: 'about-us', href: `${prefix}/about-us/` },
  { key: 'brand-story', href: `${prefix}/brand-story/` },
  { key: 'product', href: `${prefix}/product/` },
  { key: 'production', href: `${prefix}/production/` },
  { key: 'services', href: `${prefix}/services/` },
  { key: 'blog', href: `${prefix}/blog/` },
  { key: 'contact', href: `${prefix}/contact/` },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-gray-100 bg-white/90 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between">
    <a href={`${prefix}/`} class="flex items-center gap-2 font-bold text-brand-800">
      <span class="text-xl">🥔</span>
      <span>XION</span>
    </a>
    <nav class="hidden items-center gap-1 lg:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-medium transition',
            path === item.href
              ? 'bg-brand-50 text-brand-700'
              : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900',
          ]}
        >
          {ui.nav[item.key]}
        </a>
      ))}
    </nav>
    <a href={`${prefix}/contact/`} class="btn-primary hidden sm:inline-flex">{ui.requestQuote}</a>
    <button id="menu-toggle" class="lg:hidden text-gray-600" aria-label="Toggle menu">
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <!-- mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-gray-100 lg:hidden">
    <nav class="container-x flex flex-col gap-1 py-3">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-medium',
            path === item.href ? 'bg-brand-50 text-brand-700' : 'text-gray-600 hover:bg-gray-50',
          ]}
        >
          {ui.nav[item.key]}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
