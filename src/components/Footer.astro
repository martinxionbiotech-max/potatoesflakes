---
import { UI } from '../ui';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const ui = UI[lang || 'en'];
const prefix = lang && lang !== 'en' ? `/${lang}` : '';
---

<footer class="mt-16 bg-brand-950 text-gray-300">
  <div class="container-x grid gap-10 py-14 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-2 text-lg font-bold text-white">
        <span>🥔</span><span>XION</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed">
        The Leading Professional Manufacturer of Potato Flakes and Instant Mashed Potato Powder in the world.
      </p>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-white">{ui.requestQuote}</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li>Phone: <a href="tel:+864006330616" class="hover:text-white">+86 400-633-0616</a></li>
        <li>Email: <a href="mailto:Ashelyhongjigroupllc@gmail.com" class="hover:text-white">Ashelyhongjigroupllc@gmail.com</a></li>
        <li>Address: 3# building, high tech new town, North Silicon Valley Qiaodong District, Zhangjiakou City, Hebei, China</li>
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-semibold uppercase tracking-wider text-white">Site Links</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href={`${prefix}/privacy-policy/`} class="hover:text-white">Privacy Policy</a></li>
        <li><a href={`${prefix}/terms-and-conditions/`} class="hover:text-white">Terms &amp; Conditions</a></li>
        <li><a href={`${prefix}/about-us/`} class="hover:text-white">{ui.nav['about-us']}</a></li>
        <li><a href={`${prefix}/contact/`} class="hover:text-white">{ui.nav['contact']}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10 py-6 text-center text-xs text-gray-500">
    Copyright © 2026 | XION Potato Flakes Manufacturer. All Rights Reserved.
  </div>
</footer>
